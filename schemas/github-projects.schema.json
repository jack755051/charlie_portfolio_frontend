{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charlie-portfolio.local/schemas/github-projects.schema.json",
  "title": "GitHub Projects Snapshot JSON",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "sourceFetchedAt",
    "isStale",
    "staleAt",
    "version",
    "projects"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "source": { "type": "string", "const": "github" },
    "sourceFetchedAt": { "type": "string", "format": "date-time" },
    "isStale": { "type": "boolean" },
    "staleAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "version": { "type": "integer", "minimum": 1 },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "duration",
          "technologies",
          "status",
          "type",
          "repoUrl",
          "stars",
          "lastUpdatedAt",
          "pinned",
          "isVisible"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
          },
          "title": { "type": "string", "minLength": 1 },
          "titleZh": { "type": ["string", "null"] },
          "description": { "type": "string" },
          "descriptionZh": { "type": ["string", "null"] },
          "role": { "type": ["string", "null"] },
          "duration": { "type": "string", "minLength": 1 },
          "technologies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "icon": { "type": ["string", "null"] },
                "category": { "type": ["string", "null"] }
              }
            }
          },
          "status": {
            "type": "string",
            "enum": ["wip", "done", "archived"]
          },
          "type": { "type": "string", "const": "personal" },
          "homepage": {
            "type": ["string", "null"],
            "pattern": "^https://"
          },
          "repoUrl": {
            "type": "string",
            "pattern": "^https://github\\.com/"
          },
          "stars": { "type": "integer", "minimum": 0 },
          "lastUpdatedAt": { "type": "string", "format": "date-time" },
          "pinned": { "type": "boolean" },
          "isVisible": { "type": "boolean" },
          "screenshots": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url"],
              "properties": {
                "url": { "type": "string", "minLength": 1 },
                "caption": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
