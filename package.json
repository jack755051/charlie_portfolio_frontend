{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' nuxt dev",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' nuxt build",
    "generate": "NODE_OPTIONS='--max-old-space-size=8192' nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "sync:leetcode": "node scripts/sync-leetcode.mjs",
    "validate:ssot": "node scripts/validate-json-ssot.mjs",
    "lint": "eslint .",
